{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "aiad/certificate-showcase",
	"version": "0.1.0",
	"title": "Certificate Showcase",
	"category": "aiad",
	"icon": "awards",
	"description": "The AI Risk & Readiness Benchmark pitch and the certificate it earns. Same output as the [aiad_certificate_showcase] shortcode. Needs the benchmark plugin to draw the certificate.",
	"keywords": [
		"certificate",
		"benchmark",
		"audit"
	],
	"textdomain": "aiad-core",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"lead": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"ctaText": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"ctaUrl": {
			"type": "string",
			"default": ""
		},
		"certEyebrow": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"certTitle": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"certLead": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"strand": {
			"type": "string",
			"default": "safe"
		},
		"tone": {
			"type": "string",
			"default": ""
		},
		"sectionId": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:../../../assets/css/certificate-showcase.css",
	"render": "file:./render.php"
}
