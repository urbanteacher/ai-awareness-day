{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "aiad/item",
  "title": "Styled list item",
  "category": "theme",
  "icon": "excerpt-view",
  "description": "One item of a styled list, holding any blocks.",
  "keywords": [
    "item",
    "card"
  ],
  "textdomain": "ai-awareness-day",
  "attributes": {
    "tagName": {
      "type": "string",
      "enum": [
        "li",
        "div"
      ],
      "default": "li"
    }
  },
  "supports": {
    "html": false,
    "className": false
  },
  "editorScript": "file:./index.js"
}