# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.claude/
.kilocodemodes

# Stray screenshots at theme root (not theme assets)
/Screenshot_*.jpg
/Screenshot_*.png

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
/node_modules/
/vendor/

# WordPress core (not needed - we're only deploying theme files)
wp-config.php
wp-content/uploads/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# Development/backup files
*.bak
*.backup
*.tmp
*.temp

# Documentation and history (moved to not needed/)
.history/
not needed/

# Environment files
.env
.env.local
.env.*.local

# Build files at repository root only (nested apps may have their own dist)
/dist/
/build/

# Next.js / tooling at repository root only (nested DEMO/ is a Vite app we track)
/package.json
/package-lock.json
/yarn.lock
/next.config.*
/tsconfig.json
/src/
/.next/
/postcss.config.*
/tailwind.config.*

# Vite UI demos build output
/archive/demo/dist/
/archive/demo/node_modules/

# Legacy path (pre-archive move)
/DEMO/dist/

# Composer (no dependencies, lock file auto-generated by Hostinger)
composer.lock


# Generated CSS bundles (optional local build — not loaded by WordPress)
assets/css/bundles/*.css

# Local signup export — contains PII, never commit
scripts/_external.csv

# Presenter's laptop only: signs the browser in as the demo administrator. Never deployed.
/demo-start.php
/demo-walkthrough.html

# Scratch HTML from scripts/export-debate-guides.mjs
scripts/.debate-guides/

# Rendered films and audio in the archive (hundreds of MB): kept on disk, never committed or deployed.
archive/**/*.mp4
archive/**/*.m4a
archive/**/*.mov
archive/**/*.wav
archive/**/*.mp3

# PNG exports of the brand SVGs (scripts/export-brand-pngs.mjs); the site uses the SVGs. aiad27-mark.png is tracked
# because inc/migrate-2027-branding.php imports it.
assets/brand/aiad27/*.png
!assets/brand/aiad27/aiad27-mark.png
assets/images/polygon-shapes/*.png
